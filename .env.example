POSTGRES_USER=tiki
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tikiinsight

DATABASE_URL=postgresql+psycopg://tiki:change_me@postgres:5432/tikiinsight
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tiki_reviews

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Or use Groq
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

LLM_MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0.2

PHOBERT_MODEL_PATH=models/phobert/best_model.pt
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HYBRID_RETRIEVAL_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=1800
